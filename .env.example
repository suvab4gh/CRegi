# Solana payment verification
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SETTLEMENT_WALLET=

# Circle adapter
# Use "demo" for the stage-safe default.
# Use "gateway-readiness" to call Circle Gateway /info during settlement.
# Use "cctp-readiness" to call Circle Iris /v2/publicKeys during settlement.
CIRCLE_SETTLEMENT_MODE=demo
CIRCLE_GATEWAY_API_BASE=https://gateway-api-testnet.circle.com/v1
CIRCLE_IRIS_API_BASE=https://iris-api-sandbox.circle.com
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_ENTITY_SECRET_CIPHERTEXT=

# Avalanche settlement receipt
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_PRIVATE_KEY=
AVALANCHE_LIVE_SETTLEMENT=false

# Local/demo convenience
CREGI_DEMO_MODE=false
